<mujoco model="robot_dog">
  <compiler angle="degree" coordinate="local"/>
  
  <option timestep="0.002" integrator="implicitfast" solver="Newton" iterations="50"/>

  <default>
    <joint damping="2.0" limited="true" armature="0.1"/>
    <geom type="capsule" rgba="0.8 0.6 0.4 1" condim="3" friction="1.0 0.005 0.0001"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <worldbody>
    <geom type="plane" size="10 10 0.1" rgba="0.9 0.9 0.9 1" friction="1.0 0.005 0.0001"/>
    <light pos="0 0 3" dir="0 0 -1"/>

    <body name="torso" pos="0 0 0.35">
      <freejoint/>
      <geom type="box" size="0.12 0.06 0.03" rgba="0.2 0.4 0.8 1" mass="2.0"/>
      <inertial pos="0 0 0" mass="2.0" diaginertia="0.02 0.02 0.01"/>

      <body name="front_left" pos="0.1 0.06 -0.03">
        <joint name="fl_joint" type="hinge" axis="0 1 0" range="-60 60" damping="2.0"/>
        <geom fromto="0 0 0 0.02 0 -0.22" size="0.018" rgba="0.6 0.3 0.2 1" mass="0.15"/>
        <inertial pos="0.01 0 -0.11" mass="0.15" diaginertia="0.001 0.001 0.0001"/>
      </body>

      <body name="front_right" pos="0.1 -0.06 -0.03">
        <joint name="fr_joint" type="hinge" axis="0 1 0" range="-60 60" damping="2.0"/>
        <geom fromto="0 0 0 0.02 0 -0.22" size="0.018" rgba="0.6 0.3 0.2 1" mass="0.15"/>
        <inertial pos="0.01 0 -0.11" mass="0.15" diaginertia="0.001 0.001 0.0001"/>
      </body>

      <body name="back_left" pos="-0.1 0.06 -0.03">
        <joint name="bl_joint" type="hinge" axis="0 1 0" range="-60 60" damping="2.0"/>
        <geom fromto="0 0 0 -0.02 0 -0.22" size="0.018" rgba="0.6 0.3 0.2 1" mass="0.15"/>
        <inertial pos="-0.01 0 -0.11" mass="0.15" diaginertia="0.001 0.001 0.0001"/>
      </body>

      <body name="back_right" pos="-0.1 -0.06 -0.03">
        <joint name="br_joint" type="hinge" axis="0 1 0" range="-60 60" damping="2.0"/>
        <geom fromto="0 0 0 -0.02 0 -0.22" size="0.018" rgba="0.6 0.3 0.2 1" mass="0.15"/>
        <inertial pos="-0.01 0 -0.11" mass="0.15" diaginertia="0.001 0.001 0.0001"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="fl_joint" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="fr_joint" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="bl_joint" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="br_joint" gear="20" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>